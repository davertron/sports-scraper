{
  "nodeModulesDir": "none",
  "imports": {
    "lume/": "https://deno.land/x/lume@v3.0.1/",
    "date-fns": "./vendor/date-fns/index.js",
    "date-fns/format": "./vendor/date-fns/format.js",
    "date-fns/locale/": "./vendor/date-fns/locale/",
    "date-fns-tz": "./vendor/date-fns-tz/dist/esm/index.js"
  },
  "tasks": {
    "lume": "echo \"import 'lume/cli.ts'\" | deno run -A -",
    "build": "deno task lume",
    "serve": "deno task lume -s",
    "fe": "cd frontend && npm run watch",
    "dev": "deno run -A _start.ts"
  },
  "compilerOptions": {
    "types": [
      "lume/types.ts"
    ]
  }
}
