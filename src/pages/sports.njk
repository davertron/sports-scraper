---
layout: layout.njk
title: Sports Schedule
permalink: /sports/index.html
---

<style>
  :root {
    --ice-pack-color: #3185FC;
    --druckerman-color: #EE964B;
    --big-fat-nerds-color: #EFBCD5;
  }

  .day-names {
      display: flex;
      flex-direction: row;
      justify-content: space-between;
  }

  .day-names div {
      width: 14.285714285714286%;
      text-align: center;
      border: 1px solid #ccc;
  }

  .week-container {
      display: flex;
      flex-direction: row;
      justify-content: space-between;
      height: 100px;
      overflow: hidden;
  }

  .day-container {
      width: 14.285714285714286%;
      text-align: center;
      border: 1px solid #ccc;
  }

  .day-date {
    font-size: 12px;
    color: #666;
    text-align: right;
    padding-right: 10px;
  }

  .today {
    border: 1px solid #ccc;
  }

  .game-container {
    font-size: 12px;

    &.ice-pack {
      background-color: var(--ice-pack-color);
      color: white;
    }

    &.druckerman {
      background-color: var(--druckerman-color);
    }

    &.big-fat-nerds {
      background-color: var(--big-fat-nerds-color);
    }

    &.cancelled {
      background-color: #ccc;
      color: #666;
      text-decoration: line-through;
    }
  }

  .past-day {
    background-color: #eee;
  }

  .calendar-past-game {
    filter: brightness(0.75);
  }

  tr.ice-pack td:first-child {
    border-left: 4px solid var(--ice-pack-color);
  }

  tr.druckerman td:first-child {
    border-left: 4px solid var(--druckerman-color);
  }

  tr.big-fat-nerds td:first-child {
    border-left: 4px solid var(--big-fat-nerds-color);
  }

  thead tr {
    border-left: 4px solid #f8f9fa;
  }

  tr.cancelled {
    text-decoration: line-through;
    color: #ccc;
  }

  .hide {
    display: none;
  }
</style>

<h1 class="text-3xl font-bold">
    Sports Schedule
  </h1>

<h2 class="text-2xl font-bold">Next Three Weeks</h2>
<div class="calendar-container">
<div class="day-names">
    <div>Sun</div>
    <div>Mon</div>
    <div>Tue</div>
    <div>Wed</div>
    <div>Thu</div>
    <div>Fri</div>
    <div>Sat</div>
</div>

{% for week in nextThreeWeeks %}
    <div class="week-container">
        {% for day in week %}
            <div class="day-container {{ 'today' if day.isToday else '' }} {{ 'past-day' if day.isPast else '' }}">
                <div class="day-date">{{ day.dayOfMonth }}</div>
                {% for game in day.games %}
                    <div class="game-container {{ game.teamClass }} {{ 'calendar-past-game' if day.isPast else '' }} {{ 'cancelled' if game.cancelled else '' }}" title="{{ game.rink }}">
                        {{ game.time }} - {{ game.team }}
                    </div>
                {% endfor %}
            </div>
        {% endfor %}
    </div>
{% endfor %}

<div class="flex flex-row items-center justify-between">
  <h2 class="text-2xl font-bold my-4">Full Schedule</h2>
  <div>
    <select id="team-filter" onchange="filterTeam(this.value)" class="bg-primary px-2 py-1 rounded-sm text-white text-sm">
      <option value="">All</option>
      {% for team in teams %}
        <option value="{{ team }}">{{ team }}</option>
      {% endfor %}
    </select>
    <button id="togglePastGames" onclick="togglePastGames()" class="bg-primary px-2 py-1 rounded-sm text-white text-sm">Show Past Games</button>
  </div>
</div>
<table id="scheduleTable" class="hide-past-games">
  <thead>
    <tr>
      <th>Day</th>
      <th>Time</th>
      <th>Team</th>
      <th>Rink</th>
      <th>Score</th>
    </tr>
  </thead>
  <tbody>
    {% for row in tableRows %}
        <tr class="{{ 'past-game' if row.isPastGame else '' }} {{ row.teamClass }} {{ 'cancelled' if row.cancelled else '' }}">
            <td>{{ row.day }}</td>
            <td>{{ row.time }}</td>
            <td>{{ row.teamDisplay }}</td>
            <td>{{ row.rink }}</td>
            <td>{{ 'Cancelled' if row.cancelled else row.score }}</td>
        </tr>
    {% endfor %}
  </tbody>
</table>

<script>
  function togglePastGames() {
    const table = document.querySelector('#scheduleTable');
    const button = document.querySelector('#togglePastGames');
    table.classList.toggle('hide-past-games');
    button.textContent = table.classList.contains('hide-past-games') ? 'Show Past Games' : 'Hide Past Games';
  }

  function filterTeam(team) {
    const table = document.querySelector('#scheduleTable');
    table.querySelectorAll('tbody tr').forEach(row => {
      if (team === '' || row.classList.contains(team.replaceAll(/\s/g, '-').toLowerCase())) {
        row.classList.remove('hide');
      } else {
        row.classList.add('hide');
      }
    });
  }
</script>